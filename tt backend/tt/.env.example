# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super-secret-travel-emergency-jwt-key-32chars-min

# PostgreSQL + PostGIS Database
DATABASE_URL=postgresql://postgres:postgres_travel_2026@localhost:5432/travel_emergency_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_travel_2026
DB_NAME=travel_emergency_db
DB_SSL=false

# Redis Telemetry & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3-Compatible Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=travel-media
MINIO_REGION=us-east-1

# Emergency Alerts
# Telegram Bot API (Free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_EMERGENCY_CHAT_ID=

# Firebase Cloud Messaging (FCM) - Free
FIREBASE_SERVICE_ACCOUNT_KEY=

# Live Tracking
# No telemetry ping within this many seconds marks a member as missing.
MISSING_THRESHOLD_SECONDS=5
# Radius (km) alerted when a member triggers SOS.
SOS_RADIUS_KM=20

# Destination Agent
DESTINATION_AGENT_ENABLED=true
GOOGLE_GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
