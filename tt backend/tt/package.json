{
  "name": "travel-emergency-backend",
  "version": "1.0.0",
  "description": "High-throughput spatial backend for Travel & Emergency App with PostGIS, Redis, WebSockets, and MinIO",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/database/migrations','dist/database/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/database/migrator.ts"
  },
  "keywords": [
    "postgis",
    "fastify",
    "socketio",
    "redis",
    "geospatial",
    "emergency-response",
    "minio"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@turf/turf": "^7.2.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "gpxparser": "^3.0.8",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
