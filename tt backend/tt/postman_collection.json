              "mode": "raw",
              "raw": "{\n  \"email\": \"guide@himalayas.org\",\n  \"password\": \"SherpaGuide2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
