{
  "info": {
    "_postman_id": "travel-emergency-backend-v1",
    "name": "Travel & Emergency App Backend API",
    "description": "Comprehensive Postman collection for the Travel & Emergency App backend with PostGIS spatial endpoints, Redis telemetry, Good Samaritan mesh relay, MinIO S3 storage, and emergency rescue triggers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Guide",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.environment.set('jwt_token', json.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guide@himalayas.org\",\n  \"password\": \"SherpaGuide2026!\",\n  \"name\": \"Tenzing Guide\",\n  \"phone\": \"+9779812345678\",\n  \"role\": \"GUIDE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Member",
          "event": [
            {
              "listen": "test",
              "script": {
