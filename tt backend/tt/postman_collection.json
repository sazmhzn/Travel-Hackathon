              "mode": "raw",
              "raw": "{\n  \"email\": \"hiker@outdoors.com\",\n  \"password\": \"HikerPassword2026!\",\n  \"name\": \"Alex Hiker\",\n  \"phone\": \"+14155552671\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
